# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Your personal Discord user ID — enables DM delivery of the digest to your phone
# How to find it: Discord Settings → Advanced → Enable Developer Mode,
# then right-click your own username anywhere → "Copy User ID"
DISCORD_USER_ID=

# AI provider — anthropic | openai | ollama (default: anthropic)
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (local LLMs — only needed if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=all-minilm
# Set to 0 to force CPU mode if GPU/CUDA errors occur:
OLLAMA_NUM_GPU_LAYERS=
